{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zinc",
  "compatibility_date": "2026-06-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page",
    // Serves `docs/index.html` at `/docs` to match `trailingSlash` in `astro.config.mjs`
    "html_handling": "drop-trailing-slash"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}