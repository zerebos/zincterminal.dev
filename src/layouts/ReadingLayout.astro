---
// The layout for docs, changelog and notices... a sticky contents sidebar beside a 720px text column
// Below 900px the sidebar becomes a collapsible card under the intro
import Base from "./Base.astro";
import Button from "../components/site/Button.astro";
import DocSwitch from "../components/reading/DocSwitch.astro";
import Footer from "../components/site/Footer.astro";
import Header from "../components/site/Header.astro";
import LitCell from "../components/site/LitCell.astro";
import SectionSpy from "../components/reading/SectionSpy.svelte";
import Toc from "../components/reading/Toc.astro";
import type {TocEntry} from "../components/reading/toc";
import {footer, links, type NavLink} from "../data/site";
import "../styles/reading.css";
import "../styles/prose.css";

interface Props {
    title: string;
    description: string;

    /** The nav link to mark as the current page */
    current?: "docs" | "changelog";
    kicker: string;
    heading: string;
    toc: TocEntry[];

    /** Names the contents in the sidebar and to screen readers */
    tocLabel?: string;

    /** The mobile card's summary, `tocLabel` by default */
    tocSummary?: string;

    /** Shows the Guide / Config reference switch on the docs pages, marking this half */
    docs?: "guide" | "config";
}

const {title, description, current, kicker, heading, toc, tocLabel = "On this page", tocSummary = tocLabel, docs} = Astro.props;

const nav: NavLink[] = [
    {label: "Zinc", href: "/", optional: true},
    {label: "Docs", href: links.docs, current: current === "docs"},
    {label: "Changelog", href: links.changelog, current: current === "changelog"},
    {label: "Lit Cell", href: "/lit-cell", optional: true}
];
---

<Base title={title} description={description}>
    <Header links={nav} hairline="always" mobile="collapse">
        <div slot="actions" class="navcta">
            <Button href={links.download} primary>Download</Button>
        </div>
    </Header>
    <main class="doc">
        <div class="doc-side">
            {docs && <DocSwitch current={docs} label="Docs" />}
            <p class="side-label" aria-hidden="true">{tocLabel}</p>
            <nav aria-label={tocLabel}>
                <Toc entries={toc} />
            </nav>
        </div>
        <article class="prose">
            {docs && <div class="docswitch-m"><DocSwitch current={docs} label="Docs, compact" /></div>}
            <p class="kicker"><LitCell pitch={12} />{kicker}</p>
            <h1>{heading}</h1>
            <div class="intro">
                <slot name="intro" />
            </div>
            <details class="toc-m">
                <summary>{tocSummary}</summary>
                <nav aria-label={tocLabel}>
                    <Toc entries={toc} />
                </nav>
            </details>
            <div class="prose-body">
                <slot />
            </div>
            {Astro.slots.has("endnote") && <div class="endnote"><slot name="endnote" /></div>}
        </article>
    </main>
    <SectionSpy client:load ids={toc.map(entry => entry.href.slice(1))} />
    <Footer columns={footer} />
</Base>

<style>
    @media (max-width: 640px) {
        .navcta {
            display: none;
        }
    }
</style>
