---
import Base from "../layouts/Base.astro";
import CompactCta from "../components/site/CompactCta.svelte";
import Footer from "../components/site/Footer.astro";
import Header from "../components/site/Header.astro";
import Hero from "../components/landing/Hero.astro";
import PrecisionDraws from "../components/landing/PrecisionDraws.astro";
import PrecisionTune from "../components/landing/PrecisionTune.astro";
import Libghostty from "../components/landing/Libghostty.astro";
import NativeWindows from "../components/landing/NativeWindows.astro";
import Themes from "../components/landing/Themes.astro";
import TryAlpha from "../components/landing/TryAlpha.astro";
import Workflow from "../components/landing/Workflow.astro";
import {footer, links, shown, type NavLink} from "../data/site";

const nav: NavLink[] = shown([
    {label: "Precision", href: "#precision"},
    {label: "Workflow", href: "#workflow"},
    {label: "Themes", href: "#themes"},
    {label: "Docs", href: links.docs},
    {label: "GitHub", href: links.zincRepo}
]);
---
<Base
    title="Zinc, a precise, native terminal for Windows"
    description="Box lines, blocks and Powerline shapes meet without seams in any font. Every setting says what it does and applies the moment you change it."
>
    <Header links={nav}>
        <CompactCta slot="actions" client:load />
    </Header>
    <main>
        <Hero />
        <PrecisionDraws />
        <PrecisionTune />
        <Workflow />
        <NativeWindows />
        <Themes />
        <Libghostty />
        <TryAlpha />
    </main>
    <Footer columns={footer} />
</Base>
