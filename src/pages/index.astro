---
import Base from "../layouts/Base.astro";
import CompactCta from "../components/site/CompactCta.svelte";
import Footer from "../components/site/Footer.astro";
import Header from "../components/site/Header.astro";
import Hero from "../components/landing/Hero.astro";
import PrecisionDraws from "../components/landing/PrecisionDraws.astro";
import PrecisionTune from "../components/landing/PrecisionTune.astro";
import Libghostty from "../components/landing/Libghostty.astro";
import NativeWindows from "../components/landing/NativeWindows.astro";
import Workflow from "../components/landing/Workflow.astro";
import {links, type FooterColumn, type NavLink} from "../data/site";

const nav: NavLink[] = [
    {label: "Precision", href: "#precision"},
    {label: "Workflow", href: "#workflow"},
    {label: "Themes", href: "#themes"},
    {label: "Docs", href: links.docs},
    {label: "GitHub", href: links.zincRepo}
];

const footer: FooterColumn[] = [
    {
        title: "Product",
        links: [
            {label: "Features", href: "#precision"},
            {label: "Themes", href: "#themes"},
            {label: "Lit Cell", href: "/lit-cell"},
            {label: "Changelog", href: links.changelog},
            {label: "Request access", href: links.discord}
        ]
    },
    {
        title: "Docs",
        links: [
            {label: "Getting started", href: links.docs},
            {label: "Configuration", href: links.docs},
            {label: "Shell integration", href: links.docs},
            {label: "The zn CLI", href: links.docs}
        ]
    },
    {
        title: "Project",
        links: [
            {label: "Source on GitHub", href: links.zincRepo},
            {label: "Releases", href: links.zincReleases},
            {label: "Report an issue", href: links.zincIssues},
            {label: "About", href: links.about}
        ]
    }
];
---
<Base title="Zinc, a precise, native terminal for Windows">
    <Header links={nav}>
        <CompactCta slot="actions" client:load />
    </Header>
    <main>
        <Hero />
        <PrecisionDraws />
        <PrecisionTune />
        <Workflow />
        <NativeWindows />
        <section id="themes" class="sec skeleton" aria-label="Make it yours"></section>
        <Libghostty />
        <section id="install" class="sec skeleton" aria-label="Try the alpha"></section>
    </main>
    <Footer columns={footer} />
</Base>

<style>
    /* Temporary so each empty section has height and its top hairline shows where an anchor lands */
    .sec {
        border-top: 1px solid var(--line);
    }

    .skeleton {
        min-height: 60vh;
    }
</style>
