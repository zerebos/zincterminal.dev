---
import {getEntry, render} from "astro:content";
import Button from "../components/site/Button.astro";
import MdxContent from "../components/prose/MdxContent.astro";
import ReadingLayout from "../layouts/ReadingLayout.astro";
import type {TocEntry} from "../components/reading/toc";
import {formatDate} from "../lib/date";
import {links, release} from "../data/site";

const docs = await getEntry("docs", "using-zinc");
if (!docs) throw new Error("src/content/docs/using-zinc.mdx is missing");
const {Content, headings} = await render(docs);

// H2s with their H3s nested under them
const toc: TocEntry[] = [];
for (const heading of headings) {
    const link = {label: heading.text, href: `#${heading.slug}`};
    const parent = toc.at(-1);
    if (heading.depth === 2) toc.push(link);
    else if (heading.depth === 3 && parent) (parent.children ??= []).push(link);
}
---

<ReadingLayout
    title={docs.data.title}
    description={docs.data.description}
    current="docs"
    kicker="Docs"
    heading={docs.data.title}
    toc={toc}
>
    <Fragment slot="intro">
        <p class="lead">{docs.data.lead}</p>
        <p class="meta"><span>For <code>{release.version}</code></span><span>Updated {formatDate(release.date)}</span></p>
    </Fragment>
    <MdxContent content={Content} />
    <Fragment slot="endnote">
        <p><b>Didn't find what you need?</b> Ask in the Discord, where testers and the developer answer.</p>
        <Button href={links.discord}>Ask in the Discord</Button>
    </Fragment>
</ReadingLayout>
