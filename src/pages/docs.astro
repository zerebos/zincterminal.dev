---
import Button from "../components/site/Button.astro";
import ReadingLayout from "../layouts/ReadingLayout.astro";
import type {TocEntry} from "../components/reading/toc";
import {formatDate} from "../lib/date";
import {links, release} from "../data/site";

// Placeholder sections until the docs content is added
const sections: TocEntry[] = [
    {label: "Getting started", href: "#getting-started", children: [{label: "What you need", href: "#requirements"}, {label: "Install", href: "#install"}]},
    {label: "Configuration", href: "#configuration", children: [{label: "The Settings window", href: "#settings-window"}, {label: "The config file", href: "#config-file"}]},
    {label: "Shell integration", href: "#shell-integration"},
    {label: "The zn CLI", href: "#zn"}
];
const filler = "Placeholder text. This section is written in a later chunk, so this paragraph only gives the page some length to scroll.";
---

<ReadingLayout
    title="Using Zinc"
    description="How to install Zinc, set it up the way you work and script it."
    current="docs"
    kicker="Docs"
    heading="Using Zinc"
    toc={sections}
>
    <Fragment slot="intro">
        <p class="lead">How to install Zinc, set it up the way you work and script it. Written for the private alpha, so details can change between builds.</p>
        <p class="meta"><span>For <code>{release.version}</code></span><span>Updated {formatDate(release.date)}</span></p>
    </Fragment>
    {sections.map(section => (
        <section>
            <h2 id={section.href.slice(1)}>{section.label}</h2>
            <p>{filler}</p>
            {section.children?.map(child => (
                <>
                    <h3 id={child.href.slice(1)}>{child.label}</h3>
                    <p>{filler}</p>
                    <p>{filler}</p>
                </>
            ))}
            <p>{filler}</p>
        </section>
    ))}
    <Fragment slot="endnote">
        <p><b>Didn't find what you need?</b> Ask in the Discord, where testers and the developer answer.</p>
        <Button href={links.discord}>Ask in the Discord</Button>
    </Fragment>
</ReadingLayout>
