---
import BuildBody from "../components/reading/BuildBody.astro";
import Button from "../components/site/Button.astro";
import ReadingLayout from "../layouts/ReadingLayout.astro";
import type {TocEntry} from "../components/reading/toc";
import changelog from "../data/generated/zinc-changelog.json";
import {formatDate, formatDay} from "../lib/date";
import {toBuild} from "../lib/zinc/builds";
import {links} from "../data/site";

// The newest builds show in full, the rest as rows that open
const fullCount = 3;

const builds = changelog.map(toBuild);
const full = builds.slice(0, fullCount);
const older = builds.slice(fullCount);

const toc: TocEntry[] = builds.map(build => ({
    label: build.short,
    href: `#${build.id}`,
    mono: true,
    detail: formatDay(build.date)
}));
---

<ReadingLayout
    title="What's new in Zinc"
    description="What changed in each build, newest first."
    current="changelog"
    kicker="Changelog"
    heading="What's new"
    toc={toc}
    tocLabel="Builds"
    tocSummary="Jump to a build"
>
    <Fragment slot="intro">
        <p class="lead">What changed in each build, newest first. Builds are numbered <code>0.1.0-dev.N</code>, where N counts the commits behind them.</p>
        <p class="meta"><span>Not using Zinc yet? <a href="/#install">Download the latest build</a>.</span></p>
    </Fragment>
    {full.map((build, i) => (
        <section class="rel" aria-labelledby={build.id}>
            <h2 id={build.id} class="relh">
                <span class="v">{build.version}</span>
                {i === 0 && <>{" "}<span class="latest">Latest</span></>}
                <a class="anchor" href={`#${build.id}`} aria-label={`Link to ${build.version}`}></a>
            </h2>
            <p class="reldate"><time datetime={build.date}>{formatDate(build.date)}</time></p>
            <BuildBody build={build} />
        </section>
    ))}
    {older.length > 0 && (
        <>
            <h2 id="earlier">Earlier builds<a class="anchor" href="#earlier" aria-label="Link to Earlier builds"></a></h2>
            <div class="older">
                {older.map(build => (
                    <details class="old" id={build.id}>
                        <summary>
                            <span class="v">{build.version}</span>{" "}
                            <span class="d"><time datetime={build.date}>{formatDate(build.date)}</time></span>{" "}
                            <span class="c">{build.summary}</span>
                            <span class="chev" aria-hidden="true"></span>
                        </summary>
                        <div class="oldbody">
                            <BuildBody build={build} />
                        </div>
                    </details>
                ))}
            </div>
        </>
    )}
    <Fragment slot="endnote">
        <p><b>Found a bug in a build?</b> Email <a href={links.feedback}>{links.feedbackEmail}</a> with the version from Settings › About, or tell us in the Discord.</p>
        <Button href={links.feedback}>Send feedback</Button>
    </Fragment>
</ReadingLayout>

<style>
    .rel {
        margin-top: 56px;
        padding-top: 40px;
        border-top: 1px solid var(--line);
    }

    .rel:first-of-type {
        margin-top: 48px;
    }

    .relh {
        align-items: center;
        margin: 0;
        padding: 0;
        border: 0;
        font: 600 26px/34px var(--font-mono);
        letter-spacing: -0.01em;
    }

    .latest {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 8px;
        border: 1px solid var(--accent);
        border-radius: 4px;
        font: 500 12px/16px var(--font-mono);
        letter-spacing: 0;
        color: var(--accent-text);
    }

    .latest::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 1px;
        background: var(--accent);
    }

    .reldate {
        margin: 4px 0 0;
        font: 400 14px/20px var(--font-sans);
        color: var(--ink-muted);
    }

    .older {
        margin: 20px 0 0;
        border-top: 1px solid var(--line);
    }

    .old {
        border-bottom: 1px solid var(--line);
    }

    .old summary {
        display: grid;
        grid-template-columns: minmax(150px, auto) 96px minmax(0, 1fr) 16px;
        align-items: center;
        gap: 16px;
        min-height: 52px;
        padding: 4px;
        border-radius: 4px;
        list-style: none;
        cursor: pointer;
    }

    .old summary::-webkit-details-marker {
        display: none;
    }

    .old summary:hover {
        background: var(--accent-subtle);
    }

    .v {
        font: 500 14px/20px var(--font-mono);
    }

    .relh .v {
        font: inherit;
    }

    .d,
    .c {
        font: 400 13px/20px var(--font-sans);
        color: var(--ink-muted);
    }

    .c {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .chev {
        width: 8px;
        height: 8px;
        justify-self: center;
        border-right: 1.4px solid var(--ink-muted);
        border-bottom: 1.4px solid var(--ink-muted);
        transform: rotate(45deg) translate(-2px, -2px);
    }

    .old[open] .chev {
        transform: rotate(-135deg) translate(-2px, -2px);
    }

    .oldbody {
        padding: 0 4px 28px;
    }

    @media (max-width: 640px) {
        .old summary {
            grid-template-columns: minmax(0, 1fr) auto 16px;
        }

        .c {
            display: none;
        }
    }
</style>
