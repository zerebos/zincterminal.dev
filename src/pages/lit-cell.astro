---
import Base from "../layouts/Base.astro";
import Footer from "../components/site/Footer.astro";
import Header from "../components/site/Header.astro";
import HeroPair from "../components/lit-cell/HeroPair.astro";
import InUse from "../components/lit-cell/InUse.astro";
import InstallSection from "../components/lit-cell/InstallSection.astro";
import LitCellHero from "../components/lit-cell/LitCellHero.astro";
import PaletteSection from "../components/lit-cell/PaletteSection.astro";
import PortIt from "../components/lit-cell/PortIt.astro";
import ZincNod from "../components/lit-cell/ZincNod.astro";
import {footerProduct, footerProject, links, type FooterColumn, type NavLink} from "../data/site";

const nav: NavLink[] = [
    {label: "Zinc", href: "/"},
    {label: "Lit Cell", href: "/lit-cell", current: true},
    {label: "Install", href: "#install"},
    {label: "Spec", href: links.litCellSpec},
    {label: "GitHub", href: links.litCellRepo}
];

const footer: FooterColumn[] = [
    footerProduct,
    {
        title: "Lit Cell",
        links: [
            {label: "Install", href: "#install"},
            {label: "Spec", href: links.litCellSpec},
            {label: "Source on GitHub", href: links.litCellRepo},
            {label: "iTerm2-Color-Schemes", href: links.iterm2Schemes}
        ]
    },
    footerProject
];
---
<Base
    title="Lit Cell, a color scheme for any terminal"
    description="A phosphor screen, not a neon sign. A dark, quiet ground with a faint green cast, a mint phosphor green, warm amber and soft pastels you can read all day."
    image={{src: "/brand/lit-cell-og.png", alt: "Lit Cell. Dark and light color schemes for your terminal, editor and more."}}
>
    <Header links={nav} hairline="always" mobile="menu" />
    <main>
        <LitCellHero>
            <HeroPair />
        </LitCellHero>
        <PaletteSection />
        <InUse />
        <InstallSection />
        <PortIt />
        <ZincNod />
    </main>
    <Footer columns={footer}>
        <Fragment slot="legal">© 2026 Zerebos · Lit Cell is MIT licensed</Fragment>
    </Footer>
</Base>
