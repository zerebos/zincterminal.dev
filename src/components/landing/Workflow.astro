---
// Workflow... three points in a row, the sidebar and Cards screenshot, then the attention wording
import workflowDark from "../../assets/screenshots/workflow-dark.png";
import workflowLight from "../../assets/screenshots/workflow-light.png";
import Points from "../site/Points.astro";
import Screenshot from "../site/Screenshot.astro";
import Section from "../site/Section.astro";
import SectionIntro from "../site/SectionIntro.astro";
import "../../styles/zn/dot.css";

const points = [
    {title: "Workspaces, tabs and splits", text: "Group a project's tabs into a workspace, split them as you like, and find them where you left them next time."},
    {title: "Shell integration, set up for you", text: "Zinc marks each command in the gutter, so a failure stands out before you read a line. Works with PowerShell, bash, zsh, fish, nushell, elvish and osh, and with cmd (fullest through Clink)."},
    {title: "Attention, in words", text: "A dot on the tab or workspace, and a notification that says what happened."}
];
---
<Section id="workflow" labelledby="flow-title">
    <SectionIntro eyebrow="Workflow" title="A terminal that knows what your commands are doing" titleId="flow-title" titleWidth="23ch">
        Workspaces reopen where you left them. Shell integration sets itself up. When a command finishes, fails or needs you out of view, Zinc says which, and where.
    </SectionIntro>

    <div class="layout">
        <Points items={points} class="flow-points" />
        <Screenshot
            class="flow-shot"
            src={workflowDark}
            light={workflowLight}
            width={1100}
            sizes="(max-width: 640px) calc(100vw - 32px), (max-width: 1240px) calc(100vw - 80px), 1160px"
            alt="Zinc with four workspaces in a sidebar, as cards. The api workspace has a red mark because a command failed, docs a green mark because one finished, and prod an amber mark because it needs you. The focused card has three tabs and shows a build, then a test run that failed with exit code 8, with a red bar beside it in the gutter. A second card beside it shows a git log."
        />
        <div>
            <ul class="attn" aria-label="Attention examples">
                <li><span class="zn-dot zn-dot-error" />Tests failed (exit 8) in workspace 2</li>
                <li><span class="zn-dot" />Build finished in workspace 3</li>
                <li><span class="zn-dot zn-dot-caution" />ssh needs you in "prod"</li>
            </ul>
            <p class="cap">The same words appear in Windows notifications.</p>
        </div>
    </div>
</Section>

<style>
    /* Stacked... the points in a row, the screenshot across the full column, then the attention examples */
    .layout {
        display: flex;
        flex-direction: column;
        gap: 32px;
        margin-top: 48px;
    }

    .layout :global(.flow-points) {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 32px;
        margin: 0;
    }

    .layout :global(.flow-shot) {
        width: 100%;
    }

    /* Spread from edge to edge, with the middle one centered, so the row spans the screenshot and lines up with the note */
    .attn {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 32px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .attn li:nth-child(2) {
        justify-self: center;
    }

    .attn li:last-child {
        justify-self: end;
    }

    .attn li {
        display: flex;
        align-items: center;
        gap: 12px;
        font: 400 14px/20px var(--font-sans);
        color: var(--ink);
    }

    /* Centered under the three columns, as it speaks for all of them */
    .cap {
        margin: 18px 0 0;
        font: 400 12px/16px var(--font-sans);
        color: var(--ink-muted);
        text-align: center;
    }

    @media (max-width: 900px) {
        .layout :global(.flow-points) {
            grid-template-columns: 1fr;
        }

        .attn {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        /* Stacked, every status starts at the left again */
        .attn li:nth-child(n) {
            justify-self: start;
        }

        .cap {
            text-align: left;
        }
    }
</style>
