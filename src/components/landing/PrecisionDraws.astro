---
// Precision, in what it draws... the same glyphs drawn from the font and drawn by Zinc, magnified on a cell grid
import CellZoom from "./CellZoom.astro";
import Lines from "../mock/Lines.astro";
import Mock from "../mock/Mock.astro";
import Section from "../site/Section.astro";
import SectionIntro from "../site/SectionIntro.astro";
import {block, bx, pl, quad, type Line} from "../mock/term";

const glyphs: Line[] = [
    [bx("rd"), bx("lr", 3), bx("lrd"), bx("lr", 3), bx("ld")],
    [bx("ud"), " ", block(), " ", bx("ud"), " ", quad("green"), " ", bx("ud")],
    [bx("ur"), bx("lr", 3), bx("lru"), bx("lr", 3), bx("lu")]
];

const prompt: Line[] = [[pl(["~\\src\\zinc", "blue"], ["main", "green"], ["+2", "yellow"])]];
---
<Section id="precision" labelledby="draws-title">
    <SectionIntro eyebrow="Precision, in what it draws" title="Box drawing meets without seams in any font" titleId="draws-title">
        Zinc draws box lines, blocks and Powerline shapes itself, cell by cell, instead of trusting the font to line up. Raise the line height and they still join.
    </SectionIntro>

    <div class="pair">
        <Mock tag="figure" label={false} class="zoom-figure">
            <div class="panel centered" role="img" aria-label="Box drawing glyphs from a font, magnified, with gaps between rows">
                <CellZoom lines={glyphs} gap={6} />
            </div>
            <figcaption class="cap"><b>Drawn from the font.</b> With 20% more line height, each glyph stops short of its cell and the rows come apart.</figcaption>
        </Mock>
        <Mock tag="figure" label={false} class="zoom-figure">
            <div class="panel centered" role="img" aria-label="The same glyphs drawn by Zinc, magnified, meeting edge to edge">
                <CellZoom lines={glyphs} />
            </div>
            <figcaption class="cap"><b>Drawn by Zinc.</b> Every line reaches the edge of its cell, so it meets its neighbour exactly, and quadrants like ▚ share exactly one corner. <code>font.builtin-glyphs</code></figcaption>
        </Mock>
    </div>

    <div class="panel strip" role="img" aria-label="A Powerline prompt, magnified, with segments meeting without seams">
        <div class="zoom-pl"><Lines lines={prompt} /></div>
        <p class="cap"><b>Powerline, no patched font needed.</b> Separators are drawn as cell geometry, so segments sit flush at any size.</p>
    </div>
</Section>

<style>
    .pair {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        margin-top: 48px;
    }

    .pair :global(.zoom-figure) {
        flex: 1 1 420px;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .panel {
        background: var(--term-bg);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 32px;
        display: flex;
        flex-direction: column;
        gap: 20px;
        align-items: flex-start;
        min-width: 0;
        overflow: hidden;
    }

    .panel.centered {
        align-items: center;
        justify-content: center;
    }

    .panel.strip {
        margin-top: 24px;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
    }

    .cap {
        font: 400 12px/16px var(--font-sans);
        color: var(--ink-muted);
        margin: 0;
    }

    .cap b {
        color: var(--ink);
        font-weight: 600;
    }

    .cap code {
        font-family: var(--font-cascadia);
    }

    .strip .cap {
        max-width: 36ch;
    }

    .panel.strip {
        container-type: inline-size;
    }

    /* The prompt is 25 cells, or 15em, wide. It shrinks to fit a narrow panel instead of being cut off */
    .zoom-pl {
        --cell-h: 1.5em;
        font: 500 min(32px, 100cqi / 15) / 1.5 var(--font-mono);
        white-space: pre;
        color: var(--term-fg);
    }
</style>
