---
import Button from "../site/Button.astro";
import InstallCommand from "../site/InstallCommand.astro";
import Card from "../mock/Card.astro";
import CardsArea from "../mock/CardsArea.astro";
import Mock from "../mock/Mock.astro";
import TitleBar from "../mock/TitleBar.astro";
import Window from "../mock/Window.astro";
import {links, release} from "../../data/site";
import {heroDevServer, heroFocused, heroGitLog, heroLabel, heroWorkspaces} from "../../data/mocks/hero";
---
<section class="wrap hero" aria-labelledby="hero-title">
    <div class="copy">
        <p class="positioning">A precise, native terminal for Windows</p>
        <h1 id="hero-title">Every cell, exactly right.</h1>
        <p class="lead">Box lines, blocks and Powerline shapes meet without seams in any font. Every setting says what it does and applies the moment you change it.</p>
        <div class="cta">
            <Button id="hero-download" href={links.discord} primary large>Request access</Button>
            <span class="meta">Private alpha · {release.version} · free<br>Access is through Zinc's Discord server</span>
        </div>
        <InstallCommand class="install" command="winget" comment="# coming soon" />
    </div>
    <Mock class="hero-mock">
        <Window label={heroLabel}>
            <TitleBar tabs={heroWorkspaces} />
            <CardsArea>
                <Card
                    focused
                    style="flex: 1.7 1 0"
                    tabs={[{name: "pwsh", cwd: "~\\src\\zinc", selected: true}, {name: "notes"}]}
                    actions={["split", "maximize", "more"]}
                    lines={heroFocused}
                />
                <div class="side">
                    <Card dim style="flex: 1 1 0" title={{name: "git", cwd: "~\\src\\zinc"}} lines={heroGitLog} />
                    <Card dim style="flex: 1 1 0" title={{name: "npm run dev", cwd: "~\\src\\zinc-site"}} lines={heroDevServer} />
                </div>
            </CardsArea>
        </Window>
    </Mock>
</section>

<style>
    .hero {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 56px;
        padding-top: 48px;
        padding-bottom: 112px;
    }

    .copy {
        flex: 1 1 380px;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .positioning {
        margin: 0;
        font: 500 13px/20px var(--font-mono);
        color: var(--accent-text);
    }

    h1 {
        margin: 0;
        font: 600 68px/80px var(--font-display);
        letter-spacing: -0.015em;
    }

    .lead {
        margin: 0;
        font: 400 18px/26px var(--font-sans);
        color: var(--ink-muted);
        max-width: 44ch;
    }

    .cta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
    }

    .meta {
        font: 400 12px/16px var(--font-sans);
        color: var(--ink-muted);
    }

    .hero :global(.hero-mock) {
        flex: 1.6 1 600px;
    }

    .side {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .copy :global(.install) {
        max-width: 440px;
    }

    /* The focused card gets the whole width on narrower screens */
    @media (max-width: 900px) {
        .side {
            display: none;
        }
    }

    @media (max-width: 640px) {
        h1 {
            font-size: 44px;
            line-height: 52px;
        }
    }
</style>
