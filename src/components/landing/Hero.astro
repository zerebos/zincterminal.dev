---
import Button from "../site/Button.astro";
import InstallCommand from "../site/InstallCommand.astro";
import {links} from "../../data/site";
---
<section class="wrap hero" aria-labelledby="hero-title">
    <div class="copy">
        <p class="positioning">A precise, native terminal for Windows</p>
        <h1 id="hero-title">Every cell, exactly right.</h1>
        <p class="lead">Box lines, blocks and Powerline shapes meet without seams in any font. Every setting says what it does and applies the moment you change it.</p>
        <div class="cta">
            <Button id="hero-download" href={links.discord} primary large>Request access</Button>
            <span class="meta">Private alpha · 0.1.0-dev · free<br>Access is through Zinc's Discord server</span>
        </div>
        <InstallCommand class="install" command="winget" comment="# coming soon" />
    </div>
</section>

<style>
    .hero {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 56px;
        padding-top: 48px;
        padding-bottom: 112px;
    }

    .copy {
        flex: 1 1 380px;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    .positioning {
        margin: 0;
        font: 500 13px/20px var(--font-mono);
        color: var(--accent-text);
    }

    h1 {
        margin: 0;
        font: 600 68px/80px var(--font-display);
        letter-spacing: -0.015em;
    }

    .lead {
        margin: 0;
        font: 400 18px/26px var(--font-sans);
        color: var(--ink-muted);
        max-width: 44ch;
    }

    .cta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
    }

    .meta {
        font: 400 12px/16px var(--font-sans);
        color: var(--ink-muted);
    }

    .copy :global(.install) {
        max-width: 440px;
    }

    @media (max-width: 640px) {
        h1 {
            font-size: 44px;
            line-height: 52px;
        }
    }
</style>
