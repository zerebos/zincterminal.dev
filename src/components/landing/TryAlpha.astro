---
// Try the alpha... how to get it, beside what Zinc doesn't do yet
import Button from "../site/Button.astro";
import InstallCommand from "../site/InstallCommand.astro";
import Section from "../site/Section.astro";
import SectionIntro from "../site/SectionIntro.astro";
import {links, release} from "../../data/site";

const missing = [
    ["Limited accessibility", "No screen reader support for the terminal yet"],
    ["Sixel images", "Not supported; kitty graphics show their current frame"],
    ["English only", "No other languages supported"],
    ["Importing settings from other terminals", "No migration yet"],
    // ["Very large colorful output from Git Bash and MSYS2", "Slow in any Windows terminal; native programs and WSL are fine"],
];
---
<Section id="install" labelledby="install-title">
    <div class="layout">
        <div class="head"><SectionIntro eyebrow="Alpha" title="Try the alpha" titleId="install-title" /></div>
        <div class="get">
            <div class="buttons">
                <Button href={links.download} primary large>Download for Windows</Button>
                <Button href={links.downloadPortable} large>Portable zip</Button>
                <a class="textlink" href={links.zincRepo}>Source on GitHub</a>
            </div>
            <p class="cap">Zinc is in public alpha and free. The installer sets it up for your account only, with no administrator prompt, and keeps it up to date. Current build: <span class="version">{release.version}</span> · {release.requirements}</p>
            <p class="cap">Alpha builds aren't signed yet, so Windows SmartScreen may ask first: choose <b>More info</b>, then <b>Run anyway</b>.</p>
            <InstallCommand command="winget" comment="# coming soon" />
            <p class="cap">Found a bug or have an idea? <a class="textlink" href={links.zincIssues}>Open an issue on GitHub</a>, email <a class="textlink" href={links.feedback}>{links.feedbackEmail}</a> or join the <a class="textlink" href={links.discord}>Discord</a>.</p>
        </div>
        <div class="missing">
            <h3>Not there yet</h3>
            <p class="intro">What Zinc doesn't do today, so you know before you install.</p>
            <ul class="miss">
                {missing.map(([what, status]) => <li><span>{what}</span><span>{status}</span></li>)}
            </ul>
            {links.zincRoadmap && <p class="roadmap"><a class="textlink" href={links.zincRoadmap}>See the roadmap on GitHub</a></p>}
        </div>
    </div>
</Section>

<style>
    /* The title has a row to itself, so "Not there yet" starts level with the buttons */
    .layout {
        display: grid;
        grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
        grid-template-areas:
            "head ."
            "get missing";
        column-gap: 64px;
        row-gap: 20px;
        align-items: start;
    }

    .head {
        grid-area: head;
    }

    .get {
        grid-area: get;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .buttons {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
    }

    .cap {
        margin: 0;
        font: 400 13px/20px var(--font-sans);
        color: var(--ink-muted);
    }

    /* Don't break the version at its hyphen */
    .version {
        white-space: nowrap;
    }

    .missing {
        grid-area: missing;
    }

    h3 {
        margin: 0;
        font: 600 20px/28px var(--font-display);
    }

    .intro {
        margin: 8px 0 0;
        font: 400 14px/20px var(--font-sans);
        color: var(--ink-muted);
    }

    .miss {
        list-style: none;
        margin: 16px 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        border-top: 1px solid var(--line);
    }

    .miss li {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 0;
        border-bottom: 1px solid var(--line);
        font: 400 14px/20px var(--font-sans);
    }

    .miss li span:last-child {
        color: var(--ink-muted);
        text-align: right;
    }

    .roadmap {
        margin: 16px 0 0;
        font: 400 14px/20px var(--font-sans);
    }

    /* One column, with the list 64px under the actions */
    @media (max-width: 900px) {
        .layout {
            grid-template-columns: minmax(0, 1fr);
            grid-template-areas:
                "head"
                "get"
                "missing";
        }

        .missing {
            margin-top: 44px;
        }
    }
</style>
