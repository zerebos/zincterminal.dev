---
// Precision, in how you tune it... four points beside the Settings window
import settingsDark from "../../assets/screenshots/settings-dark.png";
import settingsLight from "../../assets/screenshots/settings-light.png";
import Points from "../site/Points.astro";
import Screenshot from "../site/Screenshot.astro";
import Section from "../site/Section.astro";
import SectionIntro from "../site/SectionIntro.astro";

const points = [
    {title: "Explained in plain words", text: "The config key sits underneath, for when you'd rather edit the file."},
    {title: "Saved to config.toml and applied", text: "No Save button. Undo puts the file back as it was when Settings opened."},
    {title: "Inheritance you can see", text: "A profile shows where a value comes from until it has its own."},
    {title: "A way back on every change", text: "The reset arrow appears only when a setting differs, and says where it goes back to."}
];
---
<Section labelledby="tune-title">
    <div class="layout">
        <div class="copy">
            <SectionIntro eyebrow="Precision, in how you tune it" title="Every setting says what it does" titleId="tune-title">
                Plain words for each one, a live preview as you go, applied the moment you change it, one click from undo.
            </SectionIntro>
            <Points items={points} />
            <p class="more">Hundreds of settings, each one explained like these.</p>
        </div>
        <Screenshot
            class="tune-shot"
            src={settingsDark}
            light={settingsLight}
            width={814}
            sizes="(max-width: 640px) calc(100vw - 32px), (max-width: 1076px) calc(100vw - 80px), 680px"
            alt="The Zinc Settings window on the Git Bash profile, with a live preview of the terminal above its font settings. Font is inherited from Appearance, Size and Weight are the profile's own with reset arrows, and a bar says the changes were saved to config.toml, with a button to undo 2 changes."
        />
    </div>
</Section>

<style>
    .layout {
        display: flex;
        flex-wrap: wrap;
        gap: 56px;
        align-items: center;
    }

    .copy {
        flex: 1 1 340px;
        min-width: 0;
    }

    .more {
        margin: 32px 0 0;
        font: 400 14px/20px var(--font-sans);
        color: var(--ink-muted);
    }

    .layout :global(.tune-shot) {
        flex: 1.6 1 600px;
    }
</style>
