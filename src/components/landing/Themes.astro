---
// Make it yours... Lit Cell and Lit Cell Light first, then the tuned setups
import type {ImageMetadata} from "astro";
import {Image} from "astro:assets";
import litCell from "../../assets/screenshots/gallery-lit-cell.png";
import litCellLight from "../../assets/screenshots/gallery-lit-cell-light.png";
import nightfall from "../../assets/screenshots/gallery-nightfall.png";
import overnightSlumber from "../../assets/screenshots/gallery-overnight-slumber.png";
import peppermint from "../../assets/screenshots/gallery-peppermint.png";
import pyrokaiLight from "../../assets/screenshots/gallery-pyrokai-light.png";
import Section from "../site/Section.astro";
import SectionIntro from "../site/SectionIntro.astro";
import Shot from "../site/Shot.astro";

interface Tile {
    name: string;
    caption: string;
    image: ImageMetadata;
    alt: string;
}

// Each tile is one fixed look, so it stays the same whatever theme the page is in
const litCellTiles: Tile[] = [
    {
        name: "Lit Cell",
        caption: "Cascadia Mono NF 11 pt · the default dark scheme",
        image: litCell,
        alt: "Zinc in the Lit Cell scheme, with a tab along the top, a colored git diff and a selected word"
    },
    {
        name: "Lit Cell Light",
        caption: "Cascadia Mono NF 11 pt · the default light scheme",
        image: litCellLight,
        alt: "Zinc in the Lit Cell Light scheme, with a tab along the top, a colored git diff and a selected word"
    }
];

const tunedTiles: Tile[] = [
    {
        name: "Nightfall",
        caption: "Consolas 12 pt · workspaces in the sidebar, extra padding, block cursor",
        image: nightfall,
        alt: "Zinc in the Nightfall scheme, with workspaces in the sidebar and a PowerShell git log"
    },
    {
        name: "Overnight Slumber",
        caption: "JetBrains Mono NF 11 pt · tabs, bar cursor",
        image: overnightSlumber,
        alt: "Zinc in the Overnight Slumber scheme, with two tabs along the top and a Powerline prompt"
    },
    {
        name: "Peppermint",
        caption: "Lucida Console 13 pt · workspaces in the sidebar with tabs inside, outlined block cursor",
        image: peppermint,
        alt: "Zinc in the Peppermint scheme, with workspaces in the sidebar, two tabs inside the workspace and a git log and status in cmd"
    },
    {
        name: "Pyrokai Light",
        caption: "Departure Mono 12 pt · no tabs, underline cursor",
        image: pyrokaiLight,
        alt: "Zinc in the Pyrokai Light scheme, with no tabs or title bar, only the terminal"
    }
];

// Half size, the window's own 900 DIPs, and every captured pixel
const widths = (image: ImageMetadata) => [450, 900, image.width];
---
<Section id="themes" labelledby="yours-title">
    <SectionIntro eyebrow="Make it yours" title="Tuned setups" titleId="yours-title">
        Zinc ships with two schemes of its own, <a class="textlink" href="/lit-cell">Lit Cell and Lit Cell Light</a>, and reads the rest from Ghostty's theme format.
    </SectionIntro>

    <div class="gal gal-lit">
        {litCellTiles.map(tile => (
            <Shot name={tile.name} caption={tile.caption}>
                <Image
                    src={tile.image}
                    alt={tile.alt}
                    widths={widths(tile.image)}
                    sizes="(max-width: 640px) calc(100vw - 90px), (max-width: 900px) calc(100vw - 140px), (max-width: 1240px) calc(50vw - 100px), 520px"
                    format="png"
                />
            </Shot>
        ))}
    </div>

    <div class="gal gal-tuned">
        {tunedTiles.map(tile => (
            <Shot name={tile.name} caption={tile.caption}>
                <Image
                    src={tile.image}
                    alt={tile.alt}
                    widths={widths(tile.image)}
                    sizes="(max-width: 640px) calc(100vw - 90px), (max-width: 1240px) calc(50vw - 100px), 520px"
                    format="png"
                />
            </Shot>
        ))}
    </div>
</Section>

<style>
    .gal {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
        margin-top: 48px;
    }

    .gal-tuned {
        margin-top: 24px;
    }

    .gal-tuned :global(.zn-shot-stage) {
        padding: 32px 28px;
    }

    @media (max-width: 900px) {
        .gal-lit {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 640px) {
        .gal {
            grid-template-columns: 1fr;
        }
    }
</style>
