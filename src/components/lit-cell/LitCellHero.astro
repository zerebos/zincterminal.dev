---
// The Lit Cell page's title, pitch and install buttons. The sample panes go underneath.
import Button from "../site/Button.astro";
import LitCell from "../site/LitCell.astro";
import {links} from "../../data/site";
---
<section class="wrap hero" aria-labelledby="lc-title">
    <div class="top">
        <div class="pitch">
            <p class="eyebrow"><LitCell pitch={12} />A color scheme for any terminal</p>
            <h1 id="lc-title">Lit Cell</h1>
            <p class="lead">A phosphor screen, not a neon sign. A dark, quiet ground with a faint green cast, a mint phosphor green, warm amber and soft pastels you can read all day. Lit Cell Light keeps the same hues, deepened for a pale paper ground.</p>
        </div>
        <div class="actions">
            <div class="buttons">
                <Button href="#install" primary large>Install Lit Cell</Button>
                <Button href={links.litCellSpec} large>Read the spec</Button>
            </div>
            <span class="meta">MIT licensed · In iTerm2-Color-Schemes · Dark and light</span>
        </div>
    </div>
    <slot />
</section>

<style>
    .hero {
        padding-top: 72px;
        padding-bottom: 104px;
    }

    .top {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 32px;
    }

    .pitch {
        flex: 1 1 520px;
        min-width: 0;
    }

    .eyebrow {
        font: 500 12px/16px var(--font-mono);
        color: var(--accent-text);
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 16px;
    }

    h1 {
        margin: 0;
        font: 600 68px/80px var(--font-display);
        letter-spacing: -0.015em;
    }

    .lead {
        font: 400 18px/26px var(--font-sans);
        color: var(--ink-muted);
        margin: 16px 0 0;
        max-width: 52ch;
    }

    .actions {
        flex: 0 1 auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
        align-items: flex-start;
    }

    .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .meta {
        font: 400 12px/16px var(--font-sans);
        color: var(--ink-muted);
    }

    @media (max-width: 640px) {
        h1 {
            font-size: 52px;
            line-height: 60px;
        }
    }
</style>
