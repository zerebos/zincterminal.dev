---
import type {HTMLAttributes} from "astro/types";
import "../../styles/zn/button.css";

type Props = (HTMLAttributes<"a"> | HTMLAttributes<"button">) & {
    /** A link when set, a button otherwise */
    href?: string;
    primary?: boolean;
    large?: boolean;
};

const {href, primary = false, large = false, class: className, ...rest} = Astro.props;
const classes = ["zn-btn", {"zn-btn-primary": primary, "zn-btn-lg": large}, className];
---
{
    href
    ? <a class:list={classes} href={href} {...rest as HTMLAttributes<"a">}><slot /></a>
    : <button class:list={classes} type="button" {...rest as HTMLAttributes<"button">}><slot /></button>
}
