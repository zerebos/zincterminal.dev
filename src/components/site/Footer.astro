---
// The site footer... a full-width hairline, then the lockup and descriptor, three link columns and the base row.
import Lockup from "./Lockup.astro";
import {links as site, type FooterColumn} from "../../data/site";
import "../../styles/zn/footer.css";

interface Props {
    columns: FooterColumn[];
}

const {columns} = Astro.props;
---
<div class="footer-rule">
    <footer class="zn-footer site-footer">
        <div class="zn-footer-brand">
            <Lockup height={28} />
            <p>Zinc, a precise, native terminal for Windows.</p>
        </div>
        {columns.map(column => (
            <div>
                <h2>{column.title}</h2>
                <ul>
                    {column.links.map(link => <li><a href={link.href}>{link.label}</a></li>)}
                </ul>
            </div>
        ))}
        <div class="zn-footer-base">
            <span>
                <slot name="legal">© 2026 Zerebos</slot> · <a href={site.thirdPartyNotices}>Third-party notices</a>
            </span>
            <span class="social">
                <a href={site.feedback} aria-label={`Email ${site.feedbackEmail}`} title={`Email ${site.feedbackEmail}`}>
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4.5" width="15" height="11" rx="2" /><path d="M3 6l7 5 7-5" /></svg>
                </a>
                <a href={site.discord} aria-label="Join the Discord" title="Join the Discord">
                    <!-- Discord's mark, from Simple Icons (CC0) -->
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z" /></svg>
                </a>
            </span>
        </div>
    </footer>
</div>

<style>
    .footer-rule {
        border-top: 1px solid var(--line);
    }

    /* The page column, set here so it doesn't depend on stylesheet order against .zn-footer */
    .site-footer {
        max-width: 1240px;
        margin: 0 auto;
        box-sizing: border-box;
        border-top: 0;
        padding: 64px 40px 24px;
    }

    .zn-footer-base {
        flex-wrap: wrap;
        row-gap: 8px;
        align-items: center;
    }

    /* The negative margin keeps the 40px icons from making the row taller than its text, and lines
       the glyphs up with the text when the icons wrap on phones */
    .social {
        display: flex;
        align-items: center;
        gap: 4px;
        margin: -10px;
    }

    .social a {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        color: var(--ink-muted);
    }

    .social a:hover {
        color: var(--ink);
        background: var(--accent-subtle);
        text-decoration: none;
    }

    .social a:focus-visible {
        outline: 2px solid var(--focus-ring);
        outline-offset: 2px;
    }

    .social svg {
        width: 20px;
        height: 20px;
    }

    @media (max-width: 900px) {
        .site-footer {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 640px) {
        .site-footer {
            grid-template-columns: 1fr;
            padding-left: 16px;
            padding-right: 16px;
        }
    }
</style>
