---
// A section's eyebrow (a lit cell and a mono label), H2 and lead
import LitCell from "./LitCell.astro";

interface Props {
    eyebrow: string;
    title: string;

    /** The H2's id, for the section's `aria-labelledby` */
    titleId: string;

    /** Overrides the H2's 22ch measure */
    titleWidth?: string;
}

const {eyebrow, title, titleId, titleWidth} = Astro.props;
---
<p class="eyebrow"><LitCell pitch={12} />{eyebrow}</p>
<h2 id={titleId} class="h2" style={titleWidth ? `max-width: ${titleWidth}` : undefined}>{title}</h2>
{Astro.slots.has("default") && <p class="lead"><slot /></p>}

<style>
    .eyebrow {
        font: 500 12px/16px var(--font-mono);
        color: var(--accent-text);
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 16px;
    }

    .h2 {
        font: 600 40px/52px var(--font-display);
        margin: 0;
        max-width: 22ch;
    }

    .lead {
        font: 400 18px/26px var(--font-sans);
        color: var(--ink-muted);
        margin: 16px 0 0;
        max-width: 60ch;
    }

    @media (max-width: 640px) {
        .h2 {
            font-size: 30px;
            line-height: 38px;
        }
    }
</style>
