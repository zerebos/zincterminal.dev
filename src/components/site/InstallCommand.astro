---
import CopyButton from "./CopyButton.svelte";
import "../../styles/zn/install.css";

interface Props {
    command: string;

    /** Shown after the command in bright black, like a shell comment */
    comment?: string;

    /** Adds a copy button... `true` copies the command, a string copies that instead. The comment is never copied. */
    copy?: boolean | string;
    class?: string;
}

const {command, comment, copy, class: className} = Astro.props;
const copyText = copy === true ? command : copy;
---
<div class:list={["zn-install", className]}>
    <code><span class="zn-prompt">&gt;</span>{command}{comment && <>{"  "}<span class="comment">{comment}</span></>}</code>
    {copyText && <CopyButton client:visible text={copyText} label="Copy command" />}
</div>

<style>
    .comment {
        color: var(--term-bright-black);
    }
</style>
