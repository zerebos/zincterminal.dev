---
// A page section with the site's rhythm... a hairline on top, 112px above and below (72px on phones), and the page column inside
interface Props {
    id?: string;

    /** The id of the heading that names the section */
    labelledby?: string;

    /** Names the section when it has no heading */
    label?: string;

    /** Space above and below in px, 112 by default. Phones get 72 unless it's 0. */
    padding?: number;

    /** Classes for the page column, for sections that lay out their own columns */
    class?: string;
}

const {id, labelledby, label, padding = 112, class: className} = Astro.props;
---
<section class:list={["sec", {flush: padding === 0}]} id={id} aria-labelledby={labelledby} aria-label={label} style={`--sec-pad: ${padding}px`}>
    <div class:list={["wrap", className]}>
        <slot />
    </div>
</section>

<style>
    .sec {
        padding: var(--sec-pad) 0;
        border-top: 1px solid var(--line);
    }

    @media (max-width: 640px) {
        .sec:not(.flush) {
            padding: 72px 0;
        }
    }
</style>
