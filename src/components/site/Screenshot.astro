---
// A Zinc screenshot with the window's corners and shadow. With a light twin, both are in the page and CSS shows the one
// for the current theme, as `Lockup` does, so swapping needs no js.
import type {ImageMetadata} from "astro";
import {Image} from "astro:assets";

/** A box in the screenshot's own pixels, the same in the dark and light shots */
export interface Mark {
    x: number;
    y: number;
    width: number;
    height: number;

    /** The color around the mark in both shots, as CSS, when it isn't `mica` */
    behind?: string;

    /**
     * How far into its 1.6 s pulse the mark starts, in ms, so marks that lit up at different times pulse out of step
     * as they do in the app
     */
    phase?: number;
}

interface Props {
    src: ImageMetadata;

    /** The same shot taken in light mode */
    light?: ImageMetadata;
    alt: string;

    /** The window's size when it was captured, in DIPs, so the largest it's shown at */
    width: number;

    /** As `<img sizes>`, the width it takes in the layout */
    sizes: string;

    /**
     * Attention marks in the shot that should pulse as they do in the app. Each box should hold the mark with a few
     * pixels of plain background around it, which covers the blur around the mark when the shot is scaled down.
     */
    marks?: Mark[];
    class?: string;
}

const {src, light, alt, width, sizes, marks = [], class: className} = Astro.props;

// Half size for phones, the window's own size, and every captured pixel for high-density screens
const widths = (image: ImageMetadata) => [...new Set([Math.round(width / 2), width, image.width])];

// Percentages of the shot's size, so a box stays on the same pixels at any width
const percent = (value: number, of: number) => `${(value / of) * 100}%`;
const box = (mark: Mark) =>
    `left: ${percent(mark.x, src.width)}; top: ${percent(mark.y, src.height)}; ` +
    `width: ${percent(mark.width, src.width)}; height: ${percent(mark.height, src.height)};` +
    (mark.behind ? ` background: ${mark.behind};` : "") +
    // A negative delay starts the pulse partway through, so it's already moving on the first frame
    (mark.phase ? ` animation-delay: -${mark.phase}ms;` : "");
---

<div class:list={["screenshot", className]}>
    <Image class:list={["shot", light && "shot-dark"]} src={src} alt={alt} widths={widths(src)} sizes={sizes} format="png" />
    {light && <Image class="shot shot-light" src={light} alt={alt} widths={widths(light)} sizes={sizes} format="png" />}
    {marks.map((mark) => <span class="mark-cover" style={box(mark)} aria-hidden="true"></span>)}
</div>

<style>
    .screenshot {
        position: relative;
        min-width: 0;
    }

    /* The capture's corners hold wallpaper, which the radius clips */
    .shot {
        display: block;
        width: 100%;
        height: auto;
        border-radius: var(--radius-md);
        box-shadow: var(--elevation-2);
    }

    .shot-light {
        display: none;
    }

    :global([data-theme="light"]) .shot-dark {
        display: none;
    }

    :global([data-theme="light"]) .shot-light {
        display: block;
    }

    /*
     * The mark is part of the image, so a patch of the color behind it fades over it instead.
     * At 65% the patch leaves the mark at 35%, the low point of the app's pulse.
     * With reduced motion the patch stays clear and the mark is steady.
     */
    .mark-cover {
        position: absolute;
        background: var(--mica);
        opacity: 0;
        pointer-events: none;
    }

    @media (prefers-reduced-motion: no-preference) {
        .mark-cover {
            animation: mark-cover-pulse 1.6s cubic-bezier(0.37, 0, 0.63, 1) infinite;
        }
    }

    @keyframes mark-cover-pulse {
        50% {
            opacity: 0.65;
        }
    }
</style>
