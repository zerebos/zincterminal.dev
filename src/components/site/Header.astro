---
import Button from "./Button.astro";
import Lockup from "./Lockup.astro";
import MobileMenu from "./MobileMenu.svelte";
import ScrollHairline from "./ScrollHairline.svelte";
import ThemeSwitch from "./ThemeSwitch.svelte";
import {links, siteNav, type NavPage} from "../../data/site";

interface Props {

    /** The page whose link is marked as current, none when left out */
    current?: NavPage;
}

const {current} = Astro.props;

const nav = siteNav.map(({page, ...link}) => ({...link, current: page !== undefined && page === current}));
---
<header class="sitenav">
    <div class="wrap sitenav-row">
        <a class="home" href="/" aria-label="Zinc home">
            <Lockup height={34} />
        </a>
        <nav class="topnav" aria-label="Main">
            {nav.map(link => (
                <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.current && <span class="pill" aria-hidden="true"></span>}{link.label}</a>
            ))}
        </nav>
        <div class="tools">
            <ThemeSwitch client:load transition:persist="theme-switch" />
            <slot name="actions">
                <div class="navcta">
                    <Button href={links.download} primary>Download</Button>
                </div>
            </slot>
            <MobileMenu client:load links={nav} />
        </div>
    </div>
    <ScrollHairline client:load />
</header>

<style>
    .sitenav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--ground) 82%, transparent);
        -webkit-backdrop-filter: blur(16px) saturate(140%);
        backdrop-filter: blur(16px) saturate(140%);
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s ease;

        /* Holds still when moving between pages, while the links inside it cross-fade */
        view-transition-name: site-header;
    }

    .sitenav.scrolled {
        border-bottom-color: var(--line);
    }

    .sitenav-row {
        display: flex;
        align-items: center;
        gap: 24px;
        height: 56px;
    }

    .home {
        display: flex;
        align-items: center;
        flex: none;
        min-height: 44px;
        view-transition-name: site-lockup;
    }

    .topnav {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .topnav a {
        font: 400 14px/20px var(--font-sans);
        color: var(--ink-muted);
        text-decoration: none;
        padding: 6px 12px;
        border-radius: 4px;
        position: relative;
        isolation: isolate;
    }

    /* Grows the hit area to 44px tall without changing how the link looks */
    .topnav a::before {
        content: "";
        position: absolute;
        inset: -6px 0;
    }

    .topnav a:hover,
    .topnav a[aria-current="page"] {
        color: var(--ink);
    }

    .topnav a:hover:not([aria-current="page"]) {
        background: var(--accent-subtle);
    }

    /* The current page's background, its own element so it can slide to the next page's link */
    .pill {
        position: absolute;
        inset: 0;
        z-index: -1;
        border-radius: inherit;
        background: var(--accent-subtle);
        view-transition-name: nav-current;
    }

    .tools {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* The full row needs about 675px, so the links give way to the menu button from 900px down.
       `MobileMenu` and `CompactCta` switch at the same width. */
    @media (max-width: 900px) {
        /* The links are gone, so the tools take their place at the right */
        .topnav + .tools {
            margin-left: auto;
        }

        .topnav {
            display: none;
        }
    }

    @media (max-width: 640px) {
        .sitenav-row {
            gap: 12px;
        }

        .navcta {
            display: none;
        }
    }
</style>
