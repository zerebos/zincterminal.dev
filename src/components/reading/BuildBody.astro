---
// A build's notes and groups, each group a heading with its count and its items
import type {Build} from "../../lib/zinc/builds";

interface Props {
    build: Build;
}

const {build} = Astro.props;
---

{build.notes.map(note => <p set:html={note} />)}
{build.groups.map(group => (
    <>
        <h3 class="grp">{group.name}{" "}<span class="n">{group.items.length}</span></h3>
        <ul class="items">
            {group.items.map(item => (
                <li>
                    <Fragment set:html={item.html} />
                    {item.children.length > 0 && (
                        <ul>
                            {item.children.map(child => <li set:html={child} />)}
                        </ul>
                    )}
                </li>
            ))}
        </ul>
    </>
))}

<style>
    .grp {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 28px 0 0;
        font: 600 14px/20px var(--font-sans);
    }

    .grp:first-child {
        margin-top: 8px;
    }

    .n {
        font: 500 12px/16px var(--font-mono);
        color: var(--ink-muted);
    }

    .grp + .items {
        margin-top: 10px;
    }

    .items > li {
        font-size: 15px;
        line-height: 24px;
    }

    .items > li::before {
        top: 9px;
    }
</style>
