---
// The two halves of the docs, Guide and Config reference, as a two-part switch of links
import {links} from "../../data/site";

interface Props {
    current: "guide" | "config";

    /** Names the nav, so the sidebar's and the compact one's differ */
    label: string;
    class?: string;
}

const {current, label, class: className} = Astro.props;
---

<nav class:list={["docswitch", className]} aria-label={label}>
    <a href={links.docs} aria-current={current === "guide" ? "page" : undefined}>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M2.5 3.5h4a1.5 1.5 0 0 1 1.5 1.5v8a1.5 1.5 0 0 0-1.5-1.5h-4zM13.5 3.5h-4A1.5 1.5 0 0 0 8 5v8a1.5 1.5 0 0 1 1.5-1.5h4z" /></svg>
        Guide
    </a>
    <a href={links.config} aria-current={current === "config" ? "page" : undefined}>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M3 4h10M3 8h10M3 12h6" /><path d="M11.5 10.5l1.5 1.5-1.5 1.5" /></svg>
        Config reference
    </a>
</nav>

<style>
    .docswitch {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2px;
        margin: 0 0 28px;
        padding: 3px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--surface-raised);
    }

    a {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 36px;
        padding: 0 10px;
        border-radius: 6px;
        font: 500 13px/18px var(--font-sans);
        color: var(--ink-muted);
        text-decoration: none;
        white-space: nowrap;
    }

    /* Grows the hit area to the switch's full 44px height without changing how it looks */
    a::before {
        content: "";
        position: absolute;
        inset: -4px 0;
    }

    a:hover,
    a[aria-current="page"] {
        color: var(--ink);
        background: var(--accent-subtle);
    }

    a:focus-visible {
        outline: 2px solid var(--focus-ring);
        outline-offset: 2px;
    }

    svg {
        width: 14px;
        height: 14px;
        flex: none;
    }
</style>
