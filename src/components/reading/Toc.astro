---
// A page's contents list... square markers on the top entries, nested children under them
import type {TocEntry} from "./toc";

interface Props {
    entries: TocEntry[];
}

const {entries} = Astro.props;
---

<ul class="toc">
    {entries.map(entry => (
        <li>
            <a href={entry.href}>
                <span class="mk" aria-hidden="true"></span>
                <span class:list={["label", {mono: entry.mono}]}>{entry.label}</span>
                {entry.detail && <>{" "}<span class="detail">{entry.detail}</span></>}
            </a>
            {entry.children && entry.children.length > 0 && (
                <ul>
                    {entry.children.map(child => <li><a href={child.href}>{child.label}</a></li>)}
                </ul>
            )}
        </li>
    ))}
</ul>

<style>
    .toc,
    .toc ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .toc ul {
        margin: 2px 0 10px 30px;
        border-left: 1px solid var(--line);
    }

    .toc a {
        display: flex;
        align-items: center;
        gap: 10px;
        min-height: 32px;
        padding: 0 8px;
        border-radius: 4px;
        font: 500 14px/20px var(--font-sans);
        color: var(--ink);
        text-decoration: none;
    }

    .toc ul a {
        min-height: 28px;
        padding-left: 12px;
        border-radius: 0 4px 4px 0;
        font-weight: 400;
        font-size: 13px;
        color: var(--ink-muted);
    }

    .toc a:hover,
    .toc a[aria-current="true"] {
        color: var(--ink);
    }

    .toc a:hover {
        background: var(--accent-subtle);
    }

    .mk {
        width: 8px;
        height: 8px;
        flex: none;
        border-radius: 1px;
    }

    a[aria-current="true"] .mk {
        background: var(--accent);
    }

    .mono {
        font: 500 13px/20px var(--font-mono);
    }

    .detail {
        margin-left: auto;
        font: 400 12px/16px var(--font-sans);
        color: var(--ink-muted);
    }
</style>
