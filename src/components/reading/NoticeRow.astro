---
// A component's notice, i.e. its name, version, use and license tag, opening to its source link and license text
import type {Notice} from "../../lib/zinc/types";
import {displayUrl, noticeId} from "../../lib/notices";

interface Props {
    notice: Notice;
}

const {notice} = Astro.props;
---

<details class="lic" id={noticeId(notice.name)}>
    <summary>
        <span class="who">
            <span class="nm">{notice.name}{notice.version && <>{" "}<span class="ver">{notice.version}</span></>}</span>{" "}
            <span class="use">{notice.use}</span>
        </span>{" "}
        <span class="tag" title={notice.license}>{notice.license}</span>
        <span class="chev" aria-hidden="true"></span>
    </summary>
    <div class="licbody">
        <p class="src"><a href={notice.url}>{displayUrl(notice.url)}</a></p>
        <pre tabindex="0" role="region" aria-label={`${notice.name} license`}>{notice.licenseText}</pre>
    </div>
</details>

<style>
    .lic {
        border-bottom: 1px solid var(--line);
    }

    summary {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto 16px;
        align-items: center;
        gap: 16px;
        min-height: 56px;
        padding: 8px 4px;
        border-radius: 4px;
        list-style: none;
        cursor: pointer;
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary:hover {
        background: var(--accent-subtle);
    }

    .who {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .nm {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 8px;
        font: 600 15px/22px var(--font-sans);
    }

    .ver {
        font: 400 12px/16px var(--font-mono);
        color: var(--ink-muted);
    }

    .use {
        font: 400 14px/20px var(--font-sans);
        color: var(--ink-muted);
    }

    .tag {
        max-width: 240px;
        padding: 3px 8px;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 4px;
        font: 500 12px/16px var(--font-mono);
        color: var(--ink);
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .chev {
        width: 8px;
        height: 8px;
        justify-self: center;
        border-right: 1.4px solid var(--ink-muted);
        border-bottom: 1.4px solid var(--ink-muted);
        transform: rotate(45deg) translate(-2px, -2px);
    }

    .lic[open] .chev {
        transform: rotate(-135deg) translate(-2px, -2px);
    }

    .licbody {
        padding: 0 4px 20px;
    }

    .src {
        margin: 0 0 10px;
        font: 400 13px/20px var(--font-sans);
    }

    pre {
        max-height: 360px;
        margin: 0;
        padding: 16px;
        overflow: auto;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: var(--surface-raised);
        font: 400 12px/18px var(--font-mono);
        color: var(--ink-muted);
        white-space: pre-wrap;
    }

    @media (max-width: 640px) {
        summary {
            grid-template-columns: minmax(0, 1fr) 16px;
        }

        .tag {
            grid-row: 2;
            grid-column: 1;
            justify-self: start;
        }
    }
</style>
