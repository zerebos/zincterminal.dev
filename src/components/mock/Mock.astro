---
// Holds a mock-up and its dashed placeholder label, which stays until a real screenshot replaces the mock-up
interface Props {
    /** `false` leaves the label off */
    label?: string | false;
    tag?: "div" | "figure";
    class?: string;
}

const {label = "Placeholder mock-up", tag: Tag = "div", class: className} = Astro.props;
---
<Tag class:list={["mock", className]}>
    {label && <span class="ph">{label}</span>}
    <slot />
</Tag>

<style>
    .mock {
        position: relative;
        min-width: 0;
    }

    .ph {
        position: absolute;
        z-index: 2;
        top: -12px;
        right: 16px;
        font: 500 11px/16px var(--font-mono);
        color: var(--ink-muted);
        background: var(--ground);
        border: 1px dashed var(--line);
        border-radius: 4px;
        padding: 2px 8px;
    }
</style>
