---
// A Zinc window in a mock-up. It's one image to assistive tech, so its label has to describe the whole scene.
import "../../styles/zn/window.css";

interface Props {
    label: string;

    /** Pins the window to one site theme, for the gallery's Lit Cell and Lit Cell Light tiles */
    theme?: "dark" | "light";
    class?: string;
    style?: string;
}

const {label, theme, class: className, style} = Astro.props;
---
<div class:list={["zn-window", className]} role="img" aria-label={label} data-theme={theme} style={style}>
    <slot />
</div>
