---
// The title row over the sidebar layout... the app icon and "Zinc", the command center and the caption buttons
import Caption from "./Caption.astro";
import "../../styles/zn/window.css";

interface Props {
    /** The command center's text, left out when there is none */
    center?: string;
    style?: string;
}

const {center, style} = Astro.props;
---
<div class:list={["zn-titlerow", {plain: !center}]} style={style}>
    <div class="zn-titlerow-mark"><img src="/brand/app-icon-16.png" alt="">Zinc</div>
    {center && (
        <div class="zn-center">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="6.5" cy="6.5" r="4.5" /><path d="m10 10 4.5 4.5" /></svg>
            <span class="zn-center-text">{center}</span>
            <span class="zn-center-key">Ctrl+Shift+P</span>
        </div>
    )}
    <Caption />
</div>

<style>
    .zn-titlerow {
        display: grid;
        grid-template-columns: 220px 1fr 138px;
        align-items: center;
        height: 40px;
        background: var(--mica);
    }

    .zn-titlerow.plain {
        grid-template-columns: 1fr auto;
        height: 36px;
    }

    .zn-titlerow :global(.zn-caption) {
        justify-self: end;
        align-self: stretch;
    }

    .zn-titlerow-mark {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-left: 14px;
        font: 400 12px/16px var(--font-sans);
    }

    .zn-titlerow-mark img {
        width: 16px;
        height: 16px;
        image-rendering: pixelated;
    }

    .zn-center {
        justify-self: center;
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        column-gap: 8px;
        height: 24px;
        min-width: 280px;
        max-width: 520px;
        width: 100%;
        box-sizing: border-box;
        padding: 0 10px;
        border-radius: var(--radius-card);
        border: 1px solid var(--control-stroke);
        background: var(--control-fill);
        font: 400 12px/16px var(--font-sans);
        color: var(--text-primary);
    }

    .zn-center-text {
        opacity: 0.85;
        text-align: center;
        white-space: pre;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .zn-center-key {
        font-size: 11px;
        opacity: 0.5;
    }

    .zn-center svg {
        width: 11px;
        height: 11px;
    }
</style>
