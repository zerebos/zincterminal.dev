---
// The Settings window on Profiles › Git Bash, with the live preview, the Font group and the undo bar
// Links and buttons inside are out of the tab order, because the whole window is one image
import Button from "../site/Button.astro";
import Caption from "./Caption.astro";
import Term from "./Term.astro";
import {settingsLabel, settingsPreview} from "../../data/mocks/settings";
import "../../styles/zn/settings.css";
import "../../styles/zn/sidebar.css";

// The navigation rail's icons, top to bottom. The third (Profiles) is selected and the last (About) sits at the bottom.
const rail = [
    "<path d=\"M10 2.5 13.5 6 7 12.5H3.5V9z\"/><path d=\"M3 14.5h10\"/>",
    "<rect x=\"2\" y=\"2.5\" width=\"12\" height=\"11\" rx=\"1.5\"/><path d=\"M8 2.5v11M8 8h6\"/>",
    "<circle cx=\"8\" cy=\"5.5\" r=\"2.8\"/><path d=\"M2.5 14c.6-2.8 2.8-4.3 5.5-4.3s4.9 1.5 5.5 4.3\"/>",
    "<rect x=\"1.5\" y=\"4.5\" width=\"13\" height=\"8\" rx=\"1\"/><path d=\"M4 7h1M7 7h2M11 7h1M5 10h6\"/>",
    "<rect x=\"2\" y=\"2.5\" width=\"12\" height=\"11\" rx=\"1.5\"/><path d=\"m4.5 6.5 2 1.5-2 1.5M8 10h3\"/>",
    "<path d=\"M8 2.5a4 4 0 0 0-4 4v3l-1.5 2h11L12 9.5v-3a4 4 0 0 0-4-4zM6.5 13.5a1.5 1.5 0 0 0 3 0\"/>",
    "<path d=\"M9 1.5 3.5 9H8l-1 5.5L12.5 7H8z\" stroke-linejoin=\"round\"/>"
];
const about = "<circle cx=\"8\" cy=\"8\" r=\"6\"/><path d=\"M8 7.5v4M8 5v.5\"/>";
const resetArrow = "<path d=\"M9 15 3 9l6-6\"/><path d=\"M3 9h12a6 6 0 0 1 0 12h-3\"/>";
const chevronDown = "<path d=\"m3 4.5 3 3 3-3\"/>";
---
<div class="zn-app settings" role="img" aria-label={settingsLabel}>
    <div class="top">
        <div class="title">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4" /></svg>
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11" /></svg>
            <img src="/brand/app-icon-16.png" alt="" width="16" height="16">
            Zinc Settings
        </div>
        <div class="search">
            <span>Find a setting</span>
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><circle cx="6.5" cy="6.5" r="4.5" /><path d="m10 10 4.5 4.5" /></svg>
        </div>
        <Caption />
    </div>
    <div class="body">
        <div class="zn-sidebar zn-rail nav">
            {rail.map((icon, i) => (
                <div class:list={["zn-ws", {selected: i === 2}]}>
                    <span class="zn-ws-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true" set:html={icon} /></span>
                </div>
            ))}
            <div class="zn-ws zn-ws-new about">
                <span class="zn-ws-icon"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true" set:html={about} /></span>
            </div>
        </div>
        <div class="page">
            <div class="page-head">
                <div class="breadcrumb">
                    Profiles
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
                    Git Bash
                </div>
                <span class="hide-preview">
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true"><path d="M2 8s2.2-4 6-4 6 4 6 4-2.2 4-6 4-6-4-6-4z" /><circle cx="8" cy="8" r="1.8" /><path d="M2.5 2.5l11 11" /></svg>
                    Hide preview
                </span>
            </div>
            <Term class="preview" lines={settingsPreview} />
            <p class="hint">The settings below come from the defaults until you change them here; the reset arrow gives one back.</p>
            <div class="group">
                <div class="group-hd">
                    <div><div>Font</div><div class="zn-setting-desc">Changed here: Size, Weight</div></div>
                    <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 10 4-4 4 4" /></svg>
                </div>
                <div class="row">
                    <div class="zn-setting-text">
                        <div class="zn-setting-name">Font</div>
                        <div class="zn-setting-desc">Inherited from <a href="#" tabindex="-1">Appearance</a>: JetBrainsMono Nerd Font.</div>
                        <div class="zn-setting-key">profile.git-bash.font.family</div>
                    </div>
                    <div class="zn-select" style="width: 240px"><span>JetBrainsMono Nerd Font</span><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" aria-hidden="true" set:html={chevronDown} /></div>
                </div>
                <div class="row">
                    <div class="zn-setting-text">
                        <div class="zn-setting-name">Size<button class="zn-reset" type="button" tabindex="-1" title="Back to the value every profile inherits" aria-label="Reset Size"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={resetArrow} /></button></div>
                        <div class="zn-setting-desc">Its own. Everywhere else: 11 pt, set in <a href="#" tabindex="-1">Appearance</a>.</div>
                        <div class="zn-setting-key">profile.git-bash.font.size</div>
                    </div>
                    <div class="size">
                        <div class="zn-select" style="width: 130px"><span>11.5</span><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" aria-hidden="true"><path d="m3 5 3-3 3 3M3 7l3 3 3-3" /></svg></div>
                        <span>pt</span>
                    </div>
                </div>
                <div class="row">
                    <div class="zn-setting-text">
                        <div class="zn-setting-name">Weight<button class="zn-reset" type="button" tabindex="-1" title="Back to the value every profile inherits" aria-label="Reset Weight"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={resetArrow} /></button></div>
                        <div class="zn-setting-desc">Its own. Everywhere else: Normal, set in <a href="#" tabindex="-1">Appearance</a>.</div>
                        <div class="zn-setting-key">profile.git-bash.font.weight</div>
                    </div>
                    <div class="zn-select" style="width: 240px"><span>Medium</span><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" aria-hidden="true" set:html={chevronDown} /></div>
                </div>
            </div>
        </div>
    </div>
    <div class="undo">
        <div class="zn-undo">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 8.5l3 3 7-7" /></svg>
            <span>Saved to config.toml and applied</span>
            <Button tabindex="-1">Undo 2 changes</Button>
        </div>
    </div>
</div>

<style>
    .settings {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: var(--elevation-2);
    }

    .top {
        display: grid;
        grid-template-columns: 1fr minmax(0, 420px) 1fr;
        align-items: center;
        height: 48px;
        gap: 12px;
    }

    .top :global(.zn-caption) {
        justify-self: end;
        align-self: stretch;
    }

    .title {
        display: flex;
        align-items: center;
        gap: 12px;
        padding-left: 14px;
        font: 400 12px/16px var(--font-sans);
        white-space: nowrap;
    }

    .title img {
        image-rendering: pixelated;
    }

    .search {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        width: 100%;
        max-width: 420px;
        height: 32px;
        box-sizing: border-box;
        padding: 0 11px;
        border-radius: 4px;
        border: 1px solid var(--control-stroke);
        background: var(--control-fill);
        color: var(--text-secondary);
        font: 400 14px/20px var(--font-sans);
    }

    .search span {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .body {
        display: flex;
    }

    .nav {
        background: transparent;
        flex: none;
    }

    .about {
        color: var(--text-primary);
    }

    .page {
        flex: 999 1 380px;
        min-width: 0;
        padding: 16px 24px 76px 20px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .breadcrumb {
        font: 600 28px/36px var(--font-display);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .hide-preview {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font: 400 14px/20px var(--font-sans);
    }

    .page :global(.preview) {
        border-radius: 4px;
        padding: 10px 12px;
        font-size: 13px;
    }

    .hint {
        margin: 0;
        font: 400 14px/20px var(--font-sans);
        color: var(--text-secondary);
    }

    .group {
        border: 1px solid var(--card-stroke);
        border-radius: 6px;
        background: var(--card-fill);
        overflow: hidden;
    }

    .group-hd {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
    }

    .row {
        display: grid;
        grid-template-columns: 1fr auto;
        column-gap: 24px;
        align-items: center;
        padding: 12px 16px 12px 40px;
        border-top: 1px solid var(--divider);
    }

    .size {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        width: 240px;
    }

    .undo {
        position: absolute;
        left: 52px;
        right: 0;
        bottom: 20px;
        display: flex;
        justify-content: center;
        padding: 0 16px;
    }

    @media (max-width: 900px) {
        .nav {
            display: none;
        }

        .undo {
            left: 0;
        }

        .row {
            grid-template-columns: 1fr;
            row-gap: 8px;
            padding-left: 16px;
        }
    }
</style>
