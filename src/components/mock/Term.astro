---
// A terminal's content area. Lines sits right against the tags so no whitespace leaks into the `white-space: pre` output.
import Lines from "./Lines.astro";
import type {Line} from "./term";

interface Props {
    lines: Line[];
    class?: string;
    style?: string;
}

const {lines, class: className, style} = Astro.props;
---
<div class:list={["zn-term", className]} style={style}><Lines lines={lines} /></div>
