---
// A pane in the Cards layout, with either its own tabs or a plain title over a terminal
import Term from "./Term.astro";
import type {Line} from "./term";

interface CardTab {
    name: string;

    /** The folder, shown muted after the name */
    cwd?: string;
    selected?: boolean;
}

interface Props {
    lines: Line[];

    /** Tabs for a pane with more than one */
    tabs?: CardTab[];
    title?: {name: string, cwd?: string;};

    /** Icon buttons at the right of a tabbed header */
    actions?: Array<"split" | "maximize" | "more">;
    focused?: boolean;
    dim?: boolean;
    style?: string;

    /** Overrides the terminal's padding */
    termStyle?: string;
}

const {lines, tabs, title, actions = [], focused = false, dim = false, style, termStyle} = Astro.props;
---
<div class:list={["card", {focused, dim}]} style={style}>
    <div class="card-hd">
        {tabs && tabs.map(tab => (
            <span class:list={["card-tab", {sel: tab.selected}]}>
                <svg class="card-pi" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 4l4 4-4 4M8.5 12H13" /></svg>
                {tab.name}
                {tab.cwd && <span class="cq">{tab.cwd}</span>}
                {tab.selected && (
                    <span class="card-x"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 5l6 6M11 5l-6 6" /></svg></span>
                )}
            </span>
        ))}
        {tabs && (
            <span class="card-add"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3.5v9M3.5 8h9" /></svg></span>
        )}
        {title && (
            <span class="card-ttl">
                <svg class="card-pi" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 4l4 4-4 4M8.5 12H13" /></svg>
                {title.name}
                {title.cwd && <span class="cq">{title.cwd}</span>}
            </span>
        )}
        {actions.length > 0 && <span class="grow" />}
        {actions.map(action => (
            <span class="card-ib">
                {action === "split" && <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="10" rx="1.5" /><path d="M8 3v10" /></svg>}
                {action === "maximize" && <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6V3h3M10 3h3v3M13 10v3h-3M6 13H3v-3" /></svg>}
                {action === "more" && <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="4" cy="8" r=".6" /><circle cx="8" cy="8" r=".6" /><circle cx="12" cy="8" r=".6" /></svg>}
            </span>
        ))}
    </div>
    <Term lines={lines} style={termStyle} />
</div>

<style>
    .card {
        background: var(--term-bg);
        border: 1px solid color-mix(in srgb, var(--term-bg) 82%, var(--term-fg));
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .card.focused {
        border-color: var(--accent);
        box-shadow: 0 0 0 1px var(--accent);
    }

    .card-hd {
        height: 28px;
        flex: none;
        display: flex;
        align-items: flex-end;
        gap: 2px;
        padding: 0 4px;
        background: color-mix(in srgb, var(--term-bg) 93%, var(--term-fg));
    }

    .card-tab {
        height: 24px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 0 9px;
        border-radius: 6px 6px 0 0;
        color: var(--term-bright-black);
        font: 400 12px/16px var(--font-sans);
        white-space: nowrap;
        box-sizing: border-box;
    }

    .card-tab.sel {
        background: var(--term-bg);
        color: var(--term-fg);
        padding-right: 4px;
    }

    .cq {
        color: var(--term-bright-black);
    }

    .card-x {
        width: 18px;
        height: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--term-bright-black);
    }

    .card-x svg {
        width: 10px;
        height: 10px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
        stroke-linecap: round;
    }

    .card-pi {
        width: 13px;
        height: 13px;
        fill: none;
        stroke: var(--term-blue);
        stroke-width: 1.3;
        stroke-linecap: round;
        stroke-linejoin: round;
        flex: none;
    }

    .card-ttl {
        align-self: center;
        display: flex;
        align-items: center;
        gap: 6px;
        padding-left: 6px;
        font: 400 12px/16px var(--font-sans);
        color: var(--term-fg);
        white-space: nowrap;
        overflow: hidden;
        min-width: 0;
    }

    .card-add,
    .card-ib {
        width: 24px;
        height: 22px;
        align-self: center;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--term-fg);
        opacity: 0.7;
        flex: none;
    }

    .card-add svg {
        width: 12px;
        height: 12px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.4;
        stroke-linecap: round;
    }

    .card-ib svg {
        width: 13px;
        height: 13px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.3;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .grow {
        flex: 1;
    }

    .card :global(.zn-term) {
        flex: 1 1 auto;
        font-size: 13px;
        padding: 8px 12px 10px;
    }

    .card.dim :global(.zn-term),
    .card.dim .card-ttl {
        opacity: 0.72;
    }
</style>
