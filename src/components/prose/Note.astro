---
// A note in the docs, marked with an accent square
interface Props {
    title?: string;

    /** For a link straight to the note */
    id?: string;
}

// Curled like the body text, which Astro's smart punctuation curls
const title = Astro.props.title?.replaceAll("'", "’");
---

<div class="callout" id={Astro.props.id}>
    {title && <b>{title}</b>}
    <slot />
</div>
