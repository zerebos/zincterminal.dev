---
// A warning in the docs, marked with a caution square
interface Props {
    title?: string;
}

// Curled like the body text, which Astro's smart punctuation curls
const title = Astro.props.title?.replaceAll("'", "’");
---

<div class="callout warn">
    {title && <b>{title}</b>}
    <slot />
</div>
